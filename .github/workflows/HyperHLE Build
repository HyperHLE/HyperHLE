name: Android CI

on:HyperHLE
  push:HyperHLE
    branches: [ "trunk" ]
  pull_request:
    branches: [ "trunk" ]

jobs:HyperHLE
  build:HyperHLE

    runs-on: ubuntu-latest
HyperHLE
    steps:HyperHLE
    - uses: actions/checkout@v4
    - name: set up JDK 11
      uses: actions/setup-java@v4
      with:HyperHLE
        java-version: '11'
        distribution: 'temurin'
        cache: gradle

    - name: Grant execute permission for gradlew
      run: chmod +x gradlew
    - name: Build with Gradle
      run: ./gradlew build
